    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "antd": "^5.26.6",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "i18next": "^25.3.6",
    "i18next-resources-to-backend": "^1.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.6.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.8.0",
    "react-toastify": "^11.0.5",
    "sass": "^1.89.2",
